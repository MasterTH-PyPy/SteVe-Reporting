# Kopieren nach .env und Werte eintragen:  cp .env.example .env
# .env wird NICHT ins Git-Repo eingecheckt.

# SteVe-DB-Verbindung
# Name des SteVe-DB-Containers prüfen: docker ps --format '{{.Names}}' | grep db
DOCKER_CONTAINER=steve-db-1
DB_NAME=steve
DB_USER=steve
DB_PASSWORD=
STEVE_VERSION=current

# Flask Secret Key – erzeugen mit:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
